<Window x:Class="SharpMediaFoundationInterop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:SharpMediaFoundationInterop.WPF;assembly=SharpMediaFoundationInterop.WPF"
        mc:Ignorable="d"
        Title="SharpMediaPlayer" Height="450" Width="800">

    <Grid>
        <TabControl x:Name="Tabs">
            <TabItem Header="File" x:Name="FileTab">
                <DockPanel>
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Open video..." Click="OpenVideo_Click" />
                        <Button Content="Open left and right eye..." Click="OpenStereo_Click" ToolTip="Two videos of a stereo pair, played side by side" />
                        <Separator />
                        <CheckBox x:Name="UseDirect3D" Content="Direct3D" IsChecked="True" Click="UseDirect3D_Click"
                                  ToolTip="Drawn with Direct3D, which shows a 180 or 360 degree video as a view to look around in; else into a bitmap, flat" />
                    </ToolBar>
                    <ContentControl x:Name="FileHost" />
                </DockPanel>
            </TabItem>
            <TabItem Header="MP4">
                <ctrl:VideoControl Source="{Binding MP4Source}" Looping="True" />
            </TabItem>
            <TabItem Header="Screen">
                <ctrl:VideoControl Source="{Binding ScreenSource}" Looping="True" />
            </TabItem>
            <TabItem Header="Camera">
                <ctrl:VideoControl Source="{Binding CameraSource}" Looping="True" />
            </TabItem>
            <!--<TabItem Header="HEIC">
                <ctrl:VideoControl Source="{Binding HeicSource}" Looping="True" />
            </TabItem>-->
            <!--<TabItem Header="RTSP">
                <ctrl:VideoControl Source="{Binding RtspSource}" Looping="True" />
            </TabItem>-->
        </TabControl>        
    </Grid>

