<Window x:Class="SharpMediaFoundationInterop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:SharpMediaFoundationInterop.WPF;assembly=SharpMediaFoundationInterop.WPF"
        mc:Ignorable="d"
        Title="SharpMediaPlayer" Height="450" Width="800">

    <Grid>
        <TabControl x:Name="Tabs">
            <TabItem Header="File" x:Name="FileTab">
                <DockPanel>
                    <!-- a command bar as Windows 11's apps have: no toolbar's grip -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,8">
                        <Button Click="OpenVideo_Click" ToolTip="A video, or a HEIC, HEIF or AVIF image" Padding="12,5" Margin="0,0,8,0"
                                Style="{DynamicResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE8E5;" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>
                        <Button Content="Open left and right eye..." Click="OpenStereo_Click" Visibility="Collapsed" ToolTip="Two videos of a stereo pair, played side by side"
                                Padding="12,5" Margin="0,0,8,0" />
                        <CheckBox x:Name="UseDirect3D" Content="Direct3D" IsChecked="True" Click="UseDirect3D_Click" VerticalAlignment="Center" Margin="8,0,0,0"
                                  ToolTip="Drawn with Direct3D, which shows a 180 or 360 degree video as a view to look around in; else into a bitmap, flat" />
                    </StackPanel>
                    <ContentControl x:Name="FileHost" />
                </DockPanel>
            </TabItem>
            <TabItem Header="MP4">
                <ctrl:MediaControl Source="{Binding MP4Source}" />
            </TabItem>
            <TabItem Header="Screen">
                <ctrl:MediaControl Source="{Binding ScreenSource}" Looping="True" />
            </TabItem>
            <TabItem Header="Camera">
                <ctrl:MediaControl Source="{Binding CameraSource}" Looping="True" />
            </TabItem>
            <!--<TabItem Header="HEIC">
                <ctrl:MediaControl Source="{Binding HeicSource}" Looping="True" />
            </TabItem>-->
            <!--<TabItem Header="RTSP">
                <ctrl:MediaControl Source="{Binding RtspSource}" Looping="True" />
            </TabItem>-->
        </TabControl>        
    </Grid>

