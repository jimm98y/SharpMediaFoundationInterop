<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net8.0;net10.0</TargetFrameworks>
	<LangVersion>latest</LangVersion>
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Google VR's HRIRs of ambisonics, of SADIE's measurements, for AmbisonicRenderer's binaural sound: see NOTICE.txt -->
    <EmbeddedResource Include="Output/Resources/sh_hrir_order_*.wav" LogicalName="SharpMediaFoundationInterop.%(Filename)%(Extension)" />
    <None Include="Output/Resources/NOTICE.txt" Pack="true" PackagePath="" />
  </ItemGroup>

	<!-- the public API: listed in PublicAPI.*.txt, and checked against the last release (doc/public-api.md) -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<!-- a symbol gone from the API fails the build; one added warns, until listed: an addition breaks no one -->
		<WarningsAsErrors>$(WarningsAsErrors);RS0017</WarningsAsErrors>
		<!-- overloads with optional parameters are a style choice here, not a break -->
		<NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>0.3.1</PackageValidationBaselineVersion>
	</PropertyGroup>

	<!-- .NET Framework and .NET Standard: Windows' alone, as the other platforms' interop is of .NET's of 8 (UnmanagedCallersOnly,
	     NativeLibrary, UTF-8 strings); what they lack of .NET's of Meziantou.Polyfill and Utils/Polyfills.cs -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'net472'">
		<IsLegacyTarget>true</IsLegacyTarget>
		<!-- CsWin32 makes the first two of its own; Utils/Polyfills.cs the version check, of RtlGetVersion: of Environment.OSVersion,
		     the polyfill's, .NET Framework says Windows 8 to an app not manifested for 10 -->
		<MeziantouPolyfill_ExcludedPolyfills>
			T:System.Runtime.CompilerServices.OverloadResolutionPriorityAttribute;
			T:System.Diagnostics.CodeAnalysis.UnscopedRefAttribute;
			M:System.OperatingSystem.IsWindowsVersionAtLeast(System.Int32,System.Int32,System.Int32,System.Int32)
		</MeziantouPolyfill_ExcludedPolyfills>
		<!-- the API is listed of .NET's of 8 and 10, where nint is nint, not IntPtr; package validation holds these to it -->
		<NoWarn>$(NoWarn);RS0016;RS0017</NoWarn>
	</PropertyGroup>

	<ItemGroup Condition="'$(IsLegacyTarget)' == 'true'">
		<Compile Remove="**/Android/**;**/Apple/**;**/Linux/**;**/MacOS/**;**/iOS/**" />
		<PackageReference Include="System.Memory" Version="4.6.3" />
		<PackageReference Include="Meziantou.Polyfill" Version="1.0.169">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
	</ItemGroup>
</Project>
