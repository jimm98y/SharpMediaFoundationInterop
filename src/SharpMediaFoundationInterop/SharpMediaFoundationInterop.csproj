<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.275">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Google VR's HRIRs of ambisonics, of SADIE's measurements, for AmbisonicRenderer's binaural sound: see NOTICE.txt -->
    <EmbeddedResource Include="Output/Resources/sh_hrir_order_*.wav" LogicalName="SharpMediaFoundationInterop.%(Filename)%(Extension)" />
    <None Include="Output/Resources/NOTICE.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
