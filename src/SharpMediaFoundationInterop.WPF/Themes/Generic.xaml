<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SharpMediaFoundationInterop.WPF">

    <!-- The default template's buttons: VideoControlBase.ButtonStyleKey, for another style to be based on -->
    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:VideoControlBase}, ResourceId=ButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="#55FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the seek bar's two parts of the track, either side of the thumb: a thin rounded line, the whole height to click -->
    <Style x:Key="SeekTrackPart" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the seek bar's thumb: a circle with a dot of the accent colour in it, bigger under the mouse, smaller dragged -->
    <Style x:Key="SeekThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <Ellipse Fill="#FF454545" Stroke="#FF5C5C5C" StrokeThickness="1" />
                        <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="14" />
                            <Setter TargetName="Dot" Property="Height" Value="14" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="10" />
                            <Setter TargetName="Dot" Property="Height" Value="10" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The seek bar, as Windows 11's Media Player draws it: a thin rounded track, of the accent colour - the slider's
        Foreground - up to the thumb and of its Background after it, and a round thumb with a dot in it. Clicked anywhere,
        it goes there. VideoControlBase.SeekSliderStyleKey, for another style to be based on.
    -->
    <Style x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:VideoControlBase}, ResourceId=SeekSliderStyle}" TargetType="{x:Type Slider}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Foreground" Value="#FF4CC2FF" />
        <Setter Property="Background" Value="#66FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SeekTrackPart}" Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SeekTrackPart}" Command="Slider.IncreaseLarge" Background="{TemplateBinding Background}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SeekThumb}" Foreground="{TemplateBinding Foreground}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A subtitle, its text the content: of a 720 line picture, scaled with what it is shown over, at its bottom. The
        default template's, VideoControlBase.SubtitleTemplateKey: one of the key in an application's resources draws them
        otherwise.
    -->
    <DataTemplate x:Key="{ComponentResourceKey TypeInTargetAssembly={x:Type local:VideoControlBase}, ResourceId=SubtitleTemplate}">
        <Viewbox Stretch="Uniform" VerticalAlignment="Bottom">
            <Grid Width="1280" Height="720">
                <Border x:Name="Box" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="48,0,48,56" Padding="14,4" CornerRadius="4" Background="#B0000000">
                    <TextBlock Text="{Binding}" Foreground="White" FontFamily="Segoe UI" FontSize="40"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Viewbox>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="">
                <Setter TargetName="Box" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
        The video, and over its bottom the bar of controls: shown as the mouse moves over the video and faded out a while
        after it stops - the states ControlsVisible and ControlsHidden. The buttons send the control WPF's MediaCommands; what
        they show is of the control's properties - IsPlaying, CanSeek, TimeText. A template of one's own may have any of it,
        or none: PART_Image is what frames are drawn on, PART_Seek seeks, PART_ControlsBar stays while the mouse is on it.
        The subtitle, SubtitleText, is over the picture itself - scaled with it - and over each half of it, both eyes' views,
        where ShowsSideBySide.
    -->
    <Style TargetType="{x:Type local:VideoControlBase}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VideoControlBase}">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ControlsStates">
                                <VisualState x:Name="ControlsVisible">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_ControlsBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="PART_ControlsBar" Storyboard.TargetProperty="IsHitTestVisible">
                                            <DiscreteBooleanKeyFrame KeyTime="0" Value="True" />
                                        </BooleanAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ControlsHidden">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_ControlsBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5" />
                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="PART_ControlsBar" Storyboard.TargetProperty="IsHitTestVisible">
                                            <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
                                        </BooleanAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- the picture, and the subtitles over it: scaled together, the subtitles over the picture alone -->
                        <Viewbox Stretch="Uniform">
                            <Grid>
                                <Image x:Name="PART_Image" Stretch="None" />
                                <!-- the picture's size, not the subtitles' own: those are scaled to fit it -->
                                <UniformGrid x:Name="SubtitleLayer" Rows="1" Columns="1" IsHitTestVisible="False"
                                             Width="{Binding ActualWidth, ElementName=PART_Image}" Height="{Binding ActualHeight, ElementName=PART_Image}">
                                    <ContentPresenter Content="{TemplateBinding SubtitleText}"
                                                      ContentTemplate="{StaticResource {x:Static local:VideoControlBase.SubtitleTemplateKey}}" />
                                    <ContentPresenter x:Name="SecondSubtitle" Visibility="Collapsed" Content="{TemplateBinding SubtitleText}"
                                                      ContentTemplate="{StaticResource {x:Static local:VideoControlBase.SubtitleTemplateKey}}" />
                                </UniformGrid>
                            </Grid>
                        </Viewbox>
                        <Border x:Name="PART_ControlsBar"
                                VerticalAlignment="Bottom"
                                Padding="6,14,6,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="0.45" Color="#90000000" />
                                    <GradientStop Offset="1" Color="#C0000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="RewindButton" Style="{StaticResource {x:Static local:VideoControlBase.ButtonStyleKey}}"
                                            Command="MediaCommands.Rewind" Content="&#xEB9E;" ToolTip="Play backwards; again for faster (J)" />
                                    <Button x:Name="PlayPauseButton" Style="{StaticResource {x:Static local:VideoControlBase.ButtonStyleKey}}"
                                            Command="MediaCommands.TogglePlayPause" Content="&#xE768;" ToolTip="Play or pause (Space, K)" />
                                    <Button x:Name="FastForwardButton" Style="{StaticResource {x:Static local:VideoControlBase.ButtonStyleKey}}"
                                            Command="MediaCommands.FastForward" Content="&#xEB9D;" ToolTip="Fast forward; again for faster (L)" />
                                </StackPanel>
                                <Button x:Name="SubtitleButton" DockPanel.Dock="Right" Style="{StaticResource {x:Static local:VideoControlBase.ButtonStyleKey}}"
                                        Width="40" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                        Command="{x:Static local:VideoControlBase.NextSubtitleTrackCommand}" Content="CC"
                                        ToolTip="Subtitles: the next track, or off (C)" Visibility="Collapsed" />
                                <Button x:Name="EyeButton" DockPanel.Dock="Right" Style="{StaticResource {x:Static local:VideoControlBase.ButtonStyleKey}}"
                                        Width="40" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                        Command="{x:Static local:VideoControlBase.NextEyeViewCommand}" Content="L R"
                                        ToolTip="Both eyes, the left or the right (E)" Visibility="Collapsed" />
                                <TextBlock x:Name="TimeText" DockPanel.Dock="Right"
                                           Margin="8,0,2,0" VerticalAlignment="Center"
                                           Foreground="White" FontFamily="Consolas" FontSize="12"
                                           Text="{TemplateBinding TimeText}" />
                                <Slider x:Name="PART_Seek" Margin="6,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                        Style="{StaticResource {x:Static local:VideoControlBase.SeekSliderStyleKey}}" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPlaying" Value="True">
                            <Setter TargetName="PlayPauseButton" Property="Content" Value="&#xE769;" />
                        </Trigger>
                        <!-- a live source: pausing is all there is to do -->
                        <Trigger Property="CanSeek" Value="False">
                            <Setter TargetName="RewindButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FastForwardButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TimeText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Seek" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- a stereo video: an eye can be chosen -->
                        <Trigger Property="IsStereo" Value="True">
                            <Setter TargetName="EyeButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- of two eyes' views side by side, the subtitle over each -->
                        <Trigger Property="ShowsSideBySide" Value="True">
                            <Setter TargetName="SubtitleLayer" Property="Columns" Value="2" />
                            <Setter TargetName="SecondSubtitle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasSubtitles" Value="True">
                            <Setter TargetName="SubtitleButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SubtitleTrack" Value="-1">
                            <Setter TargetName="SubtitleButton" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="EyeView" Value="Left">
                            <Setter TargetName="EyeButton" Property="Content" Value="L" />
                        </Trigger>
                        <Trigger Property="EyeView" Value="Right">
                            <Setter TargetName="EyeButton" Property="Content" Value="R" />
                        </Trigger>
                        <Trigger Property="ShowControls" Value="False">
                            <Setter TargetName="PART_ControlsBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- the pointer goes with the bar, as over a player's video -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="ShowControls" Value="True" />
                    <Condition Property="AutoHideControls" Value="True" />
                    <Condition Property="AreControlsVisible" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Cursor" Value="None" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
