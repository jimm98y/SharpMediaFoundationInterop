<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SharpMediaFoundationInterop.WPF">
    <Style TargetType="{x:Type local:VideoControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VideoControl}">
                    <Grid>
                        <Image x:Name="PART_Image" Stretch="Uniform" />
                        <Border VerticalAlignment="Bottom"
                                Background="#CC000000"
                                Padding="8,4,8,6">
                            <StackPanel>
                                <Slider x:Name="PART_PositionSlider"
                                        Minimum="0"
                                        Maximum="{Binding Duration, RelativeSource={RelativeSource TemplatedParent}}"
                                        IsEnabled="{Binding CanSeek, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,0,0,4" />
                                <Button x:Name="PART_PlayPauseButton"
                                        HorizontalAlignment="Left"
                                        Width="80"
                                        Height="24"
                                        FontSize="11"
                                        Foreground="White"
                                        Background="#44FFFFFF"
                                        BorderBrush="#80FFFFFF"
                                        Content="&#x25B6; Play" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPlaying" Value="True">
                            <Setter TargetName="PART_PlayPauseButton" Property="Content" Value="&#x23F8; Pause" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
